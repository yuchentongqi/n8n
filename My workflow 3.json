      "parameters": {
        "jsCode": "// ========== 主题池（示例，请替换为你自己的素材） ==========\nconst themes = [\n  '春日晚风',\n  '旧书与慢时光',\n  // 请在此处添加更多主题，建议30个以上\n  '示例主题3',\n  '示例主题4'\n];\n\n// ========== 情绪池（示例） ==========\nconst moods = [\n  '安静的',\n  '有点疲惫的',\n  // 请在此处添加更多情绪\n  '示例情绪3'\n];\n\n// ========== 细节池（示例） ==========\nconst details = [\n  '晾衣服时发现一只袜子的松紧带松了',\n  // 请在此处添加更多细节\n  '示例细节3'\n];\n\n// ========== 感官池（示例） ==========\nconst senses = [\n  '雨后空气里的泥土味',\n  // 请在此处添加更多感官\n  '示例感官3'\n];\n\n// ========== 随机抽取（逻辑保持不变） ==========\nconst theme = themes[Math.floor(Math.random() * themes.length)];\nconst mood = moods[Math.floor(Math.random() * moods.length)];\nconst detail = details[Math.floor(Math.random() * details.length)];\nconst sense = senses[Math.floor(Math.random() * senses.length)];\n\nreturn { theme, mood, detail, sense };"
