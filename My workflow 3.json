        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen3.7-flash\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是「与尘同栖」的专属治愈系编辑。请严格按以下格式输出：\\n【标题】\\n《文章标题》\\n【摘要】\\n摘要内容（40-60字）\\n【寄语】\\n一句治愈金句\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"文章：{{ $json.safe_article }}\"\n    }\n  ]\n}",
        "options": {}
      },
