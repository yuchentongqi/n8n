    {
      "parameters": {
        "jsCode": "// 直接读取HTTP原生返回正文\nconst rawText = $input.first().json.choices[0].message.content || \"\";\n\n// JSON转义，传给下一个节点\nconst safeText = rawText\n.replace(/\\\\/g, '\\\\\\\\')\n.replace(/\"/g, '\\\\\"')\n.replace(/\\n/g, '\\\\n')\n.replace(/\\r/g, '\\\\r');\n\nreturn [{\n  json: {\n    article_text: rawText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
