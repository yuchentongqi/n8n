    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst mediaItem = items[0].json;\nconst articleItem = items[1].json;\n\n// 1. 处理正文\nlet content = articleItem.content || '';\n\n// 去掉开头多余换行，标题和正文无缝衔接\ncontent = content.replace(/^\\n+/, '');\n\n// 段落之间正常换行\ncontent = content.replace(/\\n+/g, '<br><br>');\n\n// 删掉旧的版权声明\ncontent = content.replace(/本文为「与尘同栖」原创随笔，禁止未经授权的转载或搬运。\\s*$/g, '');\n\n// 加上你要的结尾文案（只加这一次）\ncontent += `\n<br><br>\n余生漫漫，以文寄心，与尘同栖。\n喜欢这篇随笔，别忘了点击文末「阅读原文」，前往晚风书隅品读更多同主题文字\n`;\n\n// 2. 生成公众号完整 JSON，包含 author 字段\nconst finalArticle = [{\n  article_type: \"news\",\n  title: articleItem.title,\n  thumb_media_id: mediaItem.media_id,\n  content: content,\n  author: \"yuchen\"\n}];\n\n// 输出\nreturn [{\n  json: {\n    finalArticleString: JSON.stringify(finalArticle)\n  }\n}];"
      },
