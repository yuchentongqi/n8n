      "id": "bc52c177-f00c-40e5-9f63-0e5052b5d20b",
      "name": "改文本格式1"
    },
    {
      "parameters": {
        "jsCode": "// 直接拿上游JS输出的文章文本\nconst text = $json.article_text || \"\";\n\n// 空判断\nif (!text.trim()) {\n  return [{\n    json: {\n      feishu: JSON.stringify({ text: \"❌ 错误：未获取到内容\" })\n    }\n  }];\n}\n\n// 下面你原来的标题、摘要、寄语提取+飞书拼接代码完全不动\nconst titleMatch = text.match(/【标题】\\s*《([^》]+)》/);\nconst title = titleMatch ? titleMatch[1].trim() : \"未命名随笔\";\n\nconst summaryMatch = text.match(/【摘要】\\s*([\\s\\S]*?)\\s*(?=\\n【寄语】|$)/);\nconst summary = summaryMatch ? summaryMatch[1].trim() : \"\";\n\nconst quoteMatch = text.match(/【寄语】\\s*([\\s\\S]*)/);\nconst quote = quoteMatch ? quoteMatch[1].trim() : \"愿你被世界温柔以待\";\n\nlet reportText = \"📊 【n8n采编员 · 随笔自动推送】\\n\";\nreportText += \"━━━━━━━━━━━━━━\\n\\n\";\nreportText += `《${title}》\\n`;\nreportText += `摘要：${summary}\\n\\n`;\nreportText += \"💌 今日寄语\\n\";\nreportText += `${quote}\\n\\n`;\nreportText += \"━━━━━━━━━━━━━━\\n\";\nreportText += \"📈 采编统计\\n\";\nreportText += \"• 采编文章：1 篇\\n\";\nreportText += `⏰ 采编时间：${new Date().toLocaleString(\"zh-CN\", { timeZone: \"Asia/Shanghai\" })}\\n`;\nreportText += \"🤖 采编专员：n8n采编员\";\n\nconst feishuMessage = JSON.stringify({ text: reportText });\nreturn [{ json: { feishu: feishuMessage } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
