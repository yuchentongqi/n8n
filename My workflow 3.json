      "parameters": {
        "jsCode": "// 直接读取上游HTTP原生正文，无需走选择[0]封装层\nconst rawText = $input.first().json.choices[0].message.content ?? \"\";\nconsole.log(\"原生文章原文：\", rawText);\n\nif (!rawText) {\n  return { safe_article: \"无文章内容\" };\n}\n\n// JSON安全转义，给后面摘要HTTP接口用\nconst safeArticle = rawText\n  .replace(/\\\\/g, '\\\\\\\\')\n  .replace(/\"/g, '\\\\\"')\n  .replace(/\\n/g, '\\\\n')\n  .replace(/\\r/g, '\\\\r');\n\nreturn {\n  safe_article: safeArticle\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
