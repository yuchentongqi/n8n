    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n    // 优先读取手动拆分的title\n    let originalTitle = item.json.title?.trim() || \"\";\n    const fullText = item.json.raw_full_text ?? '';\n\n    // 第一行截取失效时，正则兜底抓取标题\n    if (!originalTitle) {\n        const titleReg = /【标题】\\s*\\n*\\s*[《]?([^《》\\n]+)[》]?/;\n        const match = fullText.match(titleReg);\n        originalTitle = match && match[1].trim() ? match[1].trim() : \"无名随笔\";\n    } else {\n        // 清理第一行自带的【标题】《》标记\n        const innerMatch = originalTitle.match(/【标题】\\s*[《]?([^《》]+)[》]?/);\n        if (innerMatch) originalTitle = innerMatch[1].trim();\n    }\n\n    let cleanTitle = originalTitle;\n    cleanTitle = cleanTitle.replace(/标题[:：\\s=]*/g, '');\n    cleanTitle = cleanTitle.replace(/^\\*+|\\*+$/g, '');\n    cleanTitle = cleanTitle.replace(/#/g, ''); // 删除所有 # 符号\n    cleanTitle = cleanTitle.trim();\n    cleanTitle = `《${cleanTitle}》`;\n\n    // 同步覆盖两个字段，WP随便绑定哪个都生效\n    item.json.title = cleanTitle;\n    item.json.post_title = cleanTitle;\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        256
      ],
      "id": "56c013ae-a6d8-4dc9-9a73-11a5d7cca346",
